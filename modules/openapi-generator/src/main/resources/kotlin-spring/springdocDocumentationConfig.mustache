package {{basePackage}}

import org.springframework.context.annotation.Bean
import org.springframework.context.annotation.Configuration

import io.swagger.v3.oas.models.OpenAPI
import io.swagger.v3.oas.models.info.Info
import io.swagger.v3.oas.models.info.Contact
import io.swagger.v3.oas.models.info.License
import io.swagger.v3.oas.models.Components
import io.swagger.v3.oas.models.security.SecurityScheme

@Configuration
class SpringDocConfiguration {

    @Bean
    fun apiInfo(): OpenAPI {
        return OpenAPI()
            .info(
                Info(){{#appName}}
                    .title({{#kotlinStringLiteral}}{{{appNameRaw}}}{{/kotlinStringLiteral}}){{/appName}}
                    .description({{#kotlinStringLiteral}}{{{unescapedAppDescription}}}{{/kotlinStringLiteral}}){{#termsOfService}}
                    .termsOfService({{#kotlinStringLiteral}}{{{termsOfServiceRaw}}}{{/kotlinStringLiteral}}){{/termsOfService}}{{#openAPI}}{{#info}}{{#contact}}
                    .contact(
                        Contact(){{#infoName}}
                            .name({{#kotlinStringLiteral}}{{{infoNameRaw}}}{{/kotlinStringLiteral}}){{/infoName}}{{#infoUrl}}
                            .url({{#kotlinStringLiteral}}{{{infoUrlRaw}}}{{/kotlinStringLiteral}}){{/infoUrl}}{{#infoEmail}}
                            .email({{#kotlinStringLiteral}}{{{infoEmailRaw}}}{{/kotlinStringLiteral}}){{/infoEmail}}
                    ){{/contact}}{{#license}}
                    .license(
                        License()
                            {{#licenseInfo}}.name({{#kotlinStringLiteral}}{{{licenseInfoRaw}}}{{/kotlinStringLiteral}})
                            {{/licenseInfo}}{{#licenseUrl}}.url({{#kotlinStringLiteral}}{{{licenseUrlRaw}}}{{/kotlinStringLiteral}})
                            {{/licenseUrl}}
                    ){{/license}}{{/info}}{{/openAPI}}
                    .version({{#kotlinStringLiteral}}{{{appVersionRaw}}}{{/kotlinStringLiteral}})
            ){{#hasAuthMethods}}
            .components(
                Components(){{#authMethods}}
                    .addSecuritySchemes({{#kotlinStringLiteral}}{{{name}}}{{/kotlinStringLiteral}}, SecurityScheme(){{#isBasic}}
                        .type(SecurityScheme.Type.HTTP)
                        .scheme({{#kotlinStringLiteral}}{{{scheme}}}{{/kotlinStringLiteral}}){{#bearerFormat}}
                        .bearerFormat({{#kotlinStringLiteral}}{{{bearerFormat}}}{{/kotlinStringLiteral}}){{/bearerFormat}}{{/isBasic}}{{#isApiKey}}
                        .type(SecurityScheme.Type.APIKEY){{#isKeyInHeader}}
                        .`in`(SecurityScheme.In.HEADER){{/isKeyInHeader}}{{#isKeyInQuery}}
                        .`in`(SecurityScheme.In.QUERY){{/isKeyInQuery}}{{#isKeyInCookie}}
                        .`in`(SecurityScheme.In.COOKIE){{/isKeyInCookie}}
                        .name({{#kotlinStringLiteral}}{{{keyParamName}}}{{/kotlinStringLiteral}}){{/isApiKey}}{{#isOAuth}}
                        .type(SecurityScheme.Type.OAUTH2){{/isOAuth}}
                    ){{/authMethods}}
            ){{/hasAuthMethods}}
    }
}
