/// One owning Server-Sent Event. event is "message" when the wire field is
/// omitted; retryMilliseconds is set only when a valid retry field was present.
struct SseEvent {
    std::string event;
    std::string data;
    std::string id;
    std::optional<std::uint64_t> retryMilliseconds;
};

using SseEventCallback = std::function<bool(const SseEvent &)>;

/// Per-stream resource bounds and cooperative cancellation. Cancellation is
/// checked between network reads and after callbacks; the transport remains
/// synchronous and single-flight per HttpClientImpl instance.
struct SseStreamOptions {
    std::size_t maxLineBytes = 64U * 1024U;
    std::size_t maxEventBytes = 1024U * 1024U;
    std::function<bool()> isCancelled;
};


/// Rich HTTP response containing status, response headers, and body.
struct HttpResponseData {
    boost::beast::http::status status;
    std::map<std::string, std::string> headers;
    std::string body;
    bool isEventStream = false;
    bool streamCancelled = false;
};

class HttpClient {

public:
    HttpClient() = default;
    virtual ~HttpClient() = default;

    virtual std::pair<boost::beast::http::status, std::string>
    execute(const std::string &verb,
            const std::string &target,
            const std::string &body,
            const std::map<std::string, std::string> &headers) = 0;

    /// Execute an HTTP request and return status, response headers, and body.
    /// Default implementation wraps execute() with empty headers to preserve
    /// compatibility with custom HttpClient implementations that do not
    /// override executeWithMetadata.
    virtual HttpResponseData
    executeWithMetadata(const std::string &verb,
                        const std::string &target,
                        const std::string &body,
                        const std::map<std::string, std::string> &headers) {
        auto [status, responseBody] = execute(verb, target, body, headers);
        return HttpResponseData{status, {}, std::move(responseBody), false, false};
    }

    /// Execute an HTTP request and yield complete structured SSE events.
    /// Returning false from onEvent requests cooperative cancellation.
    /// Successful event streams are bounded per line and event rather than by
    /// aggregate response size. Non-2xx and wrong-content-type bodies retain
    /// the configured aggregate response limit and are returned in body.
    /// Throws std::invalid_argument for an empty callback or invalid bounds.
    virtual HttpResponseData
    executeStream(const std::string &,
                  const std::string &,
                  const std::string &,
                  const std::map<std::string, std::string> &,
                  SseEventCallback,
                  const SseStreamOptions & = {}) {
        throw std::logic_error(
            "Streaming is not supported by this HttpClient implementation");
    }
};

/// One declared security scheme usage: a scheme name plus the OAuth scopes
/// requested for the operation (apiKey/http schemes carry type/in/paramName/
/// httpScheme instead of scopes).
struct SecuritySchemeUse {
    std::string schemeName;
    std::string type;       // apiKey | http | oauth2 | openIdConnect | mutualTLS | unknown
    std::string in;         // header | query | cookie (apiKey)
    std::string paramName;  // apiKey parameter name
    std::string httpScheme; // basic | bearer | <custom> (http)
    std::vector<std::string> scopes;
};

/// One (OR) alternative of an operation's security requirements: every
/// scheme in the list must be satisfied (AND). An empty list means
/// anonymous access is allowed for that alternative.
struct SecurityRequirementGroup {
    std::vector<SecuritySchemeUse> ands;
};

