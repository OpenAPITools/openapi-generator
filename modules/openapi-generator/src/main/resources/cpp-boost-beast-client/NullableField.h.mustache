// ============================================================================
// NullableField — tri-state nullable wrapper
//
// Represents three distinct states for optional nullable properties:
//   Missing : property absent from JSON object (default state)
//   Null   : property present with JSON null value
//   Value  : property present with a valid JSON value
//
// This type preserves the full wire semantics required by OpenAPI tri-state
// contracts where missing, explicit null, and present-value must round-trip
// without information loss.
//
// Property mapping:
//   Required, non-null   -> T
//   Optional, non-null   -> std::optional<T>
//   Required, nullable   -> null-capable value with Missing rejected
//   Optional, nullable   -> NullableField<T>
// ============================================================================

#ifndef CPP_BOOST_BEAST_OPENAPI_CLIENT_NULLABLE_FIELD_H_
#define CPP_BOOST_BEAST_OPENAPI_CLIENT_NULLABLE_FIELD_H_

#include <type_traits>
#include <utility>
#include <stdexcept>
#include <boost/json.hpp>

template <typename T>
class NullableField {
public:
    enum class State { Missing, Null, Value };

    // Default: Missing state. T is value-initialized so the default-constructed
    // field is trivially destructible when T allows it.
    NullableField() = default;

    // Construct from a value.
    explicit NullableField(T v)
        : state_(State::Value)
        , value_(std::move(v))
    {
    }

    // Factory: create a Null state field.
    static NullableField makeNull() {
        NullableField result;
        result.state_ = State::Null;
        return result;
    }

    // Factory: create a Value state field.
    static NullableField makeValue(T v) {
        return NullableField(std::move(v));
    }

    // State query
    bool isMissing() const noexcept { return state_ == State::Missing; }
    bool isNull() const noexcept    { return state_ == State::Null; }
    bool hasValue() const noexcept  { return state_ == State::Value; }

    /// Returns true when not in Missing state (Null or Value).
    /// Compatible with PropertyStorage hasOptionalValue() convention.
    bool hasOptionalValue() const noexcept { return state_ != State::Missing; }

    /// Resets to Missing state. Compatible with PropertyStorage
    /// resetOptionalValue() convention.
    void resetOptionalValue() { resetMissing(); }

    /// Access the held value. Throws when state is Missing or Null.
    T const& value() const {
        requireValueState();
        return value_;
    }

    T& value() {
        requireValueState();
        return value_;
    }

    /// Transition to Null state. If previously in Value, the stored value is
    /// reset to a default-constructed T.
    void setNull() {
        state_ = State::Null;
        value_ = T();
    }

    /// Transition to Missing state. If previously in Value, the stored value
    /// is reset to a default-constructed T.
    void resetMissing() {
        state_ = State::Missing;
        value_ = T();
    }

    // Comparison
    bool operator==(NullableField const& other) const {
        if (state_ != other.state_) return false;
        if (state_ == State::Value) return value_ == other.value_;
        return true;
    }

    bool operator!=(NullableField const& other) const {
        return !(*this == other);
    }

    /// Convert to boost::json::value:
    ///   Missing -> returns a null json::value (caller decides to omit key)
    ///   Null    -> returns nullptr (JSON null)
    ///   Value   -> returns boost::json::value_from(value_)
    boost::json::value toJsonValue() const {
        switch (state_) {
            case State::Null:
                return nullptr;
            case State::Value:
                return boost::json::value_from(value_);
            case State::Missing:
            default:
                return nullptr;
        }
    }

private:
    void requireValueState() const {
        if (state_ == State::Missing) {
            throw std::logic_error(
                "NullableField::value() called in Missing state");
        }
        if (state_ == State::Null) {
            throw std::logic_error(
                "NullableField::value() called in Null state");
        }
    }

    State state_{State::Missing};
    T value_{};
};

// ============================================================================
// IsNullableField — trait to detect NullableField<T> at compile time.
// Used by PropertyStorage and other generic wrappers to select the correct
// forwarding methods (hasValue/isNull/setNull/resetMissing) via if constexpr.
// ============================================================================

template <typename T>
struct IsNullableField : std::false_type {};

template <typename T>
struct IsNullableField<NullableField<T>> : std::true_type {};

#endif /* CPP_BOOST_BEAST_OPENAPI_CLIENT_NULLABLE_FIELD_H_ */
