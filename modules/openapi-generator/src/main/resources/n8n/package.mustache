{
  "name": "{{npmName}}",
  "version": "{{npmVersion}}",
  "description": "n8n community node for the {{apiTitle}} API, generated by OpenAPI Generator",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "Apache-2.0",
  "author": "OpenAPI-Generator",
  "scripts": {
    "build": "tsc"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      {{#n8nCredentialRefs}}
      "dist/credentials/{{className}}.credentials.js"{{^-last}},{{/-last}}
      {{/n8nCredentialRefs}}
    ],
    "nodes": [
      "dist/nodes/{{nodeClassName}}/{{nodeClassName}}.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "n8n-workflow": "*",
    "typescript": "^5.4.0"
  }
}
