import type { IExecuteFunctions, IDataObject, IHttpRequestOptions } from 'n8n-workflow';

/**
 * Builds and sends a single HTTP request against the {{apiTitle}} API.
 * {{#n8nCredentialRefs}}
 * {{#n8nSingleCredential}}
 * Applies the one generated credential type (see credentials/{{className}}.credentials.ts).
 * {{/n8nSingleCredential}}
 * {{^n8nSingleCredential}}
 * This spec declares more than one security scheme, so more than one credential type was
 * generated (see credentials/); only the highest-priority one, "{{credentialName}}", is applied
 * to outgoing requests here by default - see the generated README's "Known limitations".
 * {{/n8nSingleCredential}}
 * {{/n8nCredentialRefs}}
 */
export async function apiRequest(
	this: IExecuteFunctions,
	method: string,
	path: string,
	body: IDataObject = {},
	qs: IDataObject = {},
): Promise<unknown> {
	{{#n8nCredentialRefs}}
	{{#-first}}
	const credentials = await this.getCredentials('{{credentialName}}');
	const baseUrl = (credentials.baseUrl as string) || '{{{basePath}}}';
	{{/-first}}
	{{/n8nCredentialRefs}}
	{{^n8nCredentialRefs}}
	const baseUrl = '{{{basePath}}}';
	{{/n8nCredentialRefs}}

	const options: IHttpRequestOptions = {
		method: method as IHttpRequestOptions['method'],
		url: baseUrl + path,
		qs,
		body,
		json: true,
	};

	if (Object.keys(body).length === 0) {
		delete options.body;
	}

	{{#n8nCredentialRefs}}
	{{#-first}}
	return this.helpers.httpRequestWithAuthentication.call(this, '{{credentialName}}', options);
	{{/-first}}
	{{/n8nCredentialRefs}}
	{{^n8nCredentialRefs}}
	return this.helpers.httpRequest(options);
	{{/n8nCredentialRefs}}
}
