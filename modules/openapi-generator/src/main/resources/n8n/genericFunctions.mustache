import type { IExecuteFunctions, IDataObject, IHttpRequestOptions } from 'n8n-workflow';

/**
 * Builds and sends a single HTTP request against the {{apiTitle}} API, applying
 * whichever credential type this node package was generated with (see
 * credentials/ApiCredentials.credentials.ts).
 */
export async function apiRequest(
	this: IExecuteFunctions,
	method: string,
	path: string,
	body: IDataObject = {},
	qs: IDataObject = {},
): Promise<unknown> {
	{{#hasAuthMethods}}
	const credentials = await this.getCredentials('apiCredentialsApi');
	const baseUrl = (credentials.baseUrl as string) || '{{{basePath}}}';
	{{/hasAuthMethods}}
	{{^hasAuthMethods}}
	const baseUrl = '{{{basePath}}}';
	{{/hasAuthMethods}}

	const options: IHttpRequestOptions = {
		method: method as IHttpRequestOptions['method'],
		url: baseUrl + path,
		qs,
		body,
		json: true,
	};

	if (Object.keys(body).length === 0) {
		delete options.body;
	}

	{{#hasAuthMethods}}
	return this.helpers.httpRequestWithAuthentication.call(this, 'apiCredentialsApi', options);
	{{/hasAuthMethods}}
	{{^hasAuthMethods}}
	return this.helpers.httpRequest(options);
	{{/hasAuthMethods}}
}
