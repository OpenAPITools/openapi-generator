import type { IExecuteFunctions, IDataObject, IHttpRequestOptions } from 'n8n-workflow';

/**
 * Builds and sends a single HTTP request against the {{apiTitle}} API.
 * {{^n8nCredentialRefs}}
 * This spec declares no security scheme, so requests are sent unauthenticated.
 * {{/n8nCredentialRefs}}
 * {{#n8nCredentialRefs}}
 * {{#n8nSingleCredential}}
 * Applies the one generated credential type (see credentials/{{className}}.credentials.ts).
 * {{/n8nSingleCredential}}
 * {{^n8nSingleCredential}}
 * {{#-first}}
 * This spec declares more than one security scheme, so more than one credential type was
 * generated (see credentials/). Each call site passes the credential name appropriate for
 * that operation's own declared security requirement (see node.mustache's execute()), falling
 * back to "{{credentialName}}" when an operation declares no security of its own.
 * {{/-first}}
 * {{/n8nSingleCredential}}
 * {{/n8nCredentialRefs}}
 */
export async function apiRequest(
	this: IExecuteFunctions,
	method: string,
	path: string,
	body: IDataObject = {},
	qs: IDataObject = {},
	credentialName?: string,
): Promise<unknown> {
	let baseUrl = '{{{basePath}}}';

	if (credentialName) {
		const credentials = await this.getCredentials(credentialName);
		baseUrl = (credentials.baseUrl as string) || baseUrl;
	}

	const options: IHttpRequestOptions = {
		method: method as IHttpRequestOptions['method'],
		url: baseUrl + path,
		qs,
		body,
		json: true,
	};

	if (Object.keys(body).length === 0) {
		delete options.body;
	}

	if (credentialName) {
		return this.helpers.httpRequestWithAuthentication.call(this, credentialName, options);
	}
	return this.helpers.httpRequest(options);
}
