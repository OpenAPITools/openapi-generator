import type {
	IExecuteFunctions,
	IDataObject,
	INodeExecutionData,
	INodeType,
	INodeTypeDescription,
} from 'n8n-workflow';
import { NodeOperationError } from 'n8n-workflow';

import { apiRequest } from './GenericFunctions';

export class {{nodeClassName}} implements INodeType {
	description: INodeTypeDescription = {
		displayName: "{{apiTitle}}",
		name: '{{nodeTypeName}}',
		icon: 'fa:plug',
		group: ['transform'],
		version: 1,
		description: "Interact with the {{apiTitle}} API",
		defaults: {
			name: "{{apiTitle}}",
		},
		inputs: ['main'],
		outputs: ['main'],
		credentials: [
			{{#n8nCredentialRefs}}
			{
				name: '{{credentialName}}',
				required: {{#n8nSingleCredential}}true{{/n8nSingleCredential}}{{^n8nSingleCredential}}false{{/n8nSingleCredential}},
			},
			{{/n8nCredentialRefs}}
		],
		properties: [
			{
				displayName: 'Resource',
				name: 'resource',
				type: 'options',
				noDataExpression: true,
				options: [
					{{#apiInfo}}
					{{#apis}}
					{
						name: '{{baseName}}',
						value: '{{baseName}}',
					},
					{{/apis}}
					{{/apiInfo}}
				],
				default: '{{#apiInfo}}{{#apis}}{{#-first}}{{baseName}}{{/-first}}{{/apis}}{{/apiInfo}}',
			},
			{{#apiInfo}}
			{{#apis}}
			{
				displayName: 'Operation',
				name: 'operation',
				type: 'options',
				noDataExpression: true,
				displayOptions: {
					show: {
						resource: ['{{baseName}}'],
					},
				},
				options: [
					{{#operations}}
					{{#operation}}
					{
						name: "{{summary}}{{^summary}}{{operationId}}{{/summary}}",
						value: '{{operationId}}',
						action: "{{summary}}{{^summary}}{{operationId}}{{/summary}}",
					},
					{{/operation}}
					{{/operations}}
				],
				default: '{{#operations}}{{#operation}}{{#-first}}{{operationId}}{{/-first}}{{/operation}}{{/operations}}',
			},
			{{/apis}}
			{{/apiInfo}}
			{{#apiInfo}}
			{{#apis}}
			{{#operations}}
			{{#operation}}
			{{#allParams}}
			{
				displayName: "{{description}}{{^description}}{{baseName}}{{/description}}",
				name: '{{paramName}}',
				type: '{{vendorExtensions.n8nFieldType}}',
				{{#vendorExtensions.n8nIsOptions}}
				options: [
					{{#allowableValues}}
					{{#enumVars}}
					{ name: "{{name}}", value: {{{value}}} },
					{{/enumVars}}
					{{/allowableValues}}
				],
				{{/vendorExtensions.n8nIsOptions}}
				{{#vendorExtensions.n8nIsCollection}}
				typeOptions: {
					multipleValues: true,
				},
				options: [
					{
						displayName: 'Value',
						name: 'value',
						type: '{{vendorExtensions.n8nCollectionItemType}}',
						{{#vendorExtensions.n8nCollectionItemIsOptions}}
						options: [
							{{#vendorExtensions.n8nCollectionItemAllowableValues}}
							{{#enumVars}}
							{ name: "{{name}}", value: {{{value}}} },
							{{/enumVars}}
							{{/vendorExtensions.n8nCollectionItemAllowableValues}}
						],
						default: {{{vendorExtensions.n8nCollectionItemDefaultLiteral}}},
						{{/vendorExtensions.n8nCollectionItemIsOptions}}
						{{^vendorExtensions.n8nCollectionItemIsOptions}}
						default: {{{vendorExtensions.n8nCollectionItemDefaultLiteral}}},
						{{/vendorExtensions.n8nCollectionItemIsOptions}}
					},
				],
				{{/vendorExtensions.n8nIsCollection}}
				default: {{{vendorExtensions.n8nDefaultLiteral}}},
				required: {{#required}}true{{/required}}{{^required}}false{{/required}},
				displayOptions: {
					show: {
						operation: ['{{operationId}}'],
					},
				},
				description: "{{description}}{{^description}}{{baseName}}{{/description}}",
			},
			{{/allParams}}
			{{/operation}}
			{{/operations}}
			{{/apis}}
			{{/apiInfo}}
		],
	};

	async execute(this: IExecuteFunctions): Promise<INodeExecutionData[][]> {
		const items = this.getInputData();
		const returnData: IDataObject[] = [];
		const resource = this.getNodeParameter('resource', 0) as string;
		const operation = this.getNodeParameter('operation', 0) as string;

		for (let i = 0; i < items.length; i++) {
			let responseData: IDataObject = {};
			let matched = false;

			{{#apiInfo}}
			{{#apis}}
			if (resource === '{{baseName}}') {
				{{#operations}}
				{{#operation}}
				if (operation === '{{operationId}}') {
					matched = true;
					const qs: IDataObject = {};
					const headers: IDataObject = {};
					const cookieParts: string[] = [];
					const formFields: IDataObject = {};
					const body: IDataObject = {};
					let wholeBodyArray: unknown[] | undefined;
					let wholeBodyScalar: string | number | boolean | undefined;
					let path = '{{{path}}}';
					{{#allParams}}
					{{#isPathParam}}
					path = path.replace('{' + '{{baseName}}' + '}', encodeURIComponent(this.getNodeParameter('{{paramName}}', i) as string));
					{{/isPathParam}}
					{{#isQueryParam}}
					{{#vendorExtensions.n8nIsCollection}}
					qs['{{baseName}}'] = (this.getNodeParameter('{{paramName}}', i) as IDataObject[]).map((entry) => entry.value);
					{{/vendorExtensions.n8nIsCollection}}
					{{^vendorExtensions.n8nIsCollection}}
					qs['{{baseName}}'] = this.getNodeParameter('{{paramName}}', i);
					{{/vendorExtensions.n8nIsCollection}}
					{{/isQueryParam}}
					{{#isHeaderParam}}
					{{#vendorExtensions.n8nIsCollection}}
					headers['{{baseName}}'] = (this.getNodeParameter('{{paramName}}', i) as IDataObject[]).map((entry) => entry.value);
					{{/vendorExtensions.n8nIsCollection}}
					{{^vendorExtensions.n8nIsCollection}}
					headers['{{baseName}}'] = this.getNodeParameter('{{paramName}}', i);
					{{/vendorExtensions.n8nIsCollection}}
					{{/isHeaderParam}}
					{{#isCookieParam}}
					cookieParts.push('{{baseName}}=' + encodeURIComponent(this.getNodeParameter('{{paramName}}', i) as string));
					{{/isCookieParam}}
					{{#isFormParam}}
					{{#isFile}}
					// '{{baseName}}' is a binary file form field; this generator does not support uploading binary data, so it is omitted from the request.
					{{/isFile}}
					{{^isFile}}
					{{#required}}
					formFields['{{baseName}}'] = this.getNodeParameter('{{paramName}}', i);
					{{/required}}
					{{^required}}
					{
						const {{paramName}}Value = this.getNodeParameter('{{paramName}}', i);
						if ({{paramName}}Value !== '') {
							formFields['{{baseName}}'] = {{paramName}}Value;
						}
					}
					{{/required}}
					{{/isFile}}
					{{/isFormParam}}
					{{#isBodyParam}}
					{{#isPrimitiveType}}
					{{#vendorExtensions.n8nIsFlattenedBodyProperty}}
					{{#vendorExtensions.n8nIsCollection}}
					body['{{baseName}}'] = (this.getNodeParameter('{{paramName}}', i) as IDataObject[]).map((entry) => entry.value);
					{{/vendorExtensions.n8nIsCollection}}
					{{^vendorExtensions.n8nIsCollection}}
					body['{{baseName}}'] = this.getNodeParameter('{{paramName}}', i);
					{{/vendorExtensions.n8nIsCollection}}
					{{/vendorExtensions.n8nIsFlattenedBodyProperty}}
					{{^vendorExtensions.n8nIsFlattenedBodyProperty}}
					wholeBodyScalar = this.getNodeParameter('{{paramName}}', i) as string | number | boolean;
					{{/vendorExtensions.n8nIsFlattenedBodyProperty}}
					{{/isPrimitiveType}}
					{{^isPrimitiveType}}
					{{#isArray}}
					wholeBodyArray = this.getNodeParameter('{{paramName}}', i) as unknown[];
					{{/isArray}}
					{{^isArray}}
					Object.assign(body, this.getNodeParameter('{{paramName}}', i) as IDataObject);
					{{/isArray}}
					{{/isPrimitiveType}}
					{{/isBodyParam}}
					{{/allParams}}
					if (cookieParts.length > 0) {
						headers['Cookie'] = cookieParts.join('; ');
					}
					responseData = (await apiRequest.call(this, '{{httpMethod}}', path, wholeBodyArray ?? wholeBodyScalar ?? body, qs, headers, formFields, '{{vendorExtensions.n8nOperationCredentialName}}')) as IDataObject;
				}
				{{/operation}}
				{{/operations}}
			}
			{{/apis}}
			{{/apiInfo}}

			if (!matched) {
				throw new NodeOperationError(this.getNode(), `Unsupported resource/operation combination: resource=${resource}, operation=${operation}`, { itemIndex: i });
			}

			returnData.push(responseData);
		}

		return [this.helpers.returnJsonArray(returnData)];
	}
}
