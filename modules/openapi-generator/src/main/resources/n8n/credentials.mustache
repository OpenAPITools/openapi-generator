import type {
	IAuthenticateGeneric,
	ICredentialType,
	INodeProperties,
} from 'n8n-workflow';

/**
 * Generated from the OpenAPI spec's declared security scheme(s). When more than one
 * scheme is declared, the first one found (priority: apiKey, then HTTP basic, then HTTP
 * bearer, then OAuth2) is wired up automatically here; any additional schemes are listed
 * in the generated README as a manual-setup limitation rather than silently dropped.
 */
export class ApiCredentials implements ICredentialType {
	name = 'apiCredentialsApi';

	displayName = "{{apiTitle}} API";

	properties: INodeProperties[] = [
		{
			displayName: 'Base URL',
			name: 'baseUrl',
			type: 'string',
			default: '{{{basePath}}}',
		},
		{{#hasApiKeyMethods}}
		{{#apiKeyMethods}}
		{{#-first}}
		{
			displayName: 'API Key',
			name: 'apiKey',
			type: 'string',
			typeOptions: { password: true },
			default: '',
		},
		{{/-first}}
		{{/apiKeyMethods}}
		{{/hasApiKeyMethods}}
		{{^hasApiKeyMethods}}
		{{#hasHttpBasicMethods}}
		{{#httpBasicMethods}}
		{{#-first}}
		{
			displayName: 'Username',
			name: 'username',
			type: 'string',
			default: '',
		},
		{
			displayName: 'Password',
			name: 'password',
			type: 'string',
			typeOptions: { password: true },
			default: '',
		},
		{{/-first}}
		{{/httpBasicMethods}}
		{{/hasHttpBasicMethods}}
		{{^hasHttpBasicMethods}}
		{{#hasHttpBearerMethods}}
		{{#httpBearerMethods}}
		{{#-first}}
		{
			displayName: 'Bearer Token',
			name: 'token',
			type: 'string',
			typeOptions: { password: true },
			default: '',
		},
		{{/-first}}
		{{/httpBearerMethods}}
		{{/hasHttpBearerMethods}}
		{{^hasHttpBearerMethods}}
		{{#hasOAuthMethods}}
		{
			displayName: 'Access Token',
			name: 'accessToken',
			type: 'string',
			typeOptions: { password: true },
			default: '',
			description: 'This spec declares an OAuth2 scheme. Full OAuth2 flow automation is a documented limitation (see README) - paste a token obtained out of band here for now.',
		},
		{{/hasOAuthMethods}}
		{{/hasHttpBearerMethods}}
		{{/hasHttpBasicMethods}}
		{{/hasApiKeyMethods}}
	];

	authenticate: IAuthenticateGeneric = {
		type: 'generic',
		properties: {
			{{=<% %>=}}
			<%#hasApiKeyMethods%>
			<%#apiKeyMethods%>
			<%#-first%>
			<%#isKeyInHeader%>
			headers: {
				'<%keyParamName%>': '={{$credentials.apiKey}}',
			},
			<%/isKeyInHeader%>
			<%#isKeyInQuery%>
			qs: {
				'<%keyParamName%>': '={{$credentials.apiKey}}',
			},
			<%/isKeyInQuery%>
			<%/-first%>
			<%/apiKeyMethods%>
			<%/hasApiKeyMethods%>
			<%^hasApiKeyMethods%>
			<%#hasHttpBasicMethods%>
			auth: {
				username: '={{$credentials.username}}',
				password: '={{$credentials.password}}',
			},
			<%/hasHttpBasicMethods%>
			<%^hasHttpBasicMethods%>
			<%#hasHttpBearerMethods%>
			headers: {
				Authorization: '=Bearer {{$credentials.token}}',
			},
			<%/hasHttpBearerMethods%>
			<%^hasHttpBearerMethods%>
			<%#hasOAuthMethods%>
			headers: {
				Authorization: '=Bearer {{$credentials.accessToken}}',
			},
			<%/hasOAuthMethods%>
			<%/hasHttpBearerMethods%>
			<%/hasHttpBasicMethods%>
			<%/hasApiKeyMethods%>
			<%={{ }}=%>
		},
	};
}
