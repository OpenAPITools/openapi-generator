defmodule {{moduleName}}.RequestBuilder do
  @moduledoc """
  Helper functions for building Tesla requests
  """

  @doc """
  Specify the request `method` when building a request.

  Does not override the `method` if one has already been specified.

  ### Parameters

  - `request` (Map) - Collected request options
  - `method` (atom) - Request method

  ### Returns

  Map
  """
  @spec method(map(), atom()) :: map()
  def method(request, method) do
    Map.put_new(request, :method, method)
  end

  @doc """
  Specify the request URL when building a request.

  Does not override the `url` if one has already been specified.

  ### Parameters

  - `request` (Map) - Collected request options
  - `url` (String) - Request URL

  ### Returns

  Map
  """
  @spec url(map(), String.t()) :: map()
  def url(request, url) do
    Map.put_new(request, :url, url)
  end

  @doc """
  Add optional parameters to the request.

  ### Parameters

  - `request` (Map) - Collected request options
  - `definitions` (Map) - Map of parameter name to parameter location.
  - `options` (KeywordList) - The provided optional parameters

  ### Returns

  Map
  """
  @spec add_optional_params(map(), %{optional(atom) => atom()}, keyword()) :: map()
  def add_optional_params(request, _, []), do: request

  def add_optional_params(request, definitions, [{key, value} | tail]) do
    case definitions do
      %{^key => location} ->
        request
        |> add_param(location, key, value)
        |> add_optional_params(definitions, tail)

      _ ->
        add_optional_params(request, definitions, tail)
    end
  end

  @doc """
  Add non-optional parameters to the request.

  ### Parameters

  - `request` (Map) - Collected request options
  - `location` (atom) - Where to put the parameter
  - `key` (atom) - The name of the parameter
  - `value` (any) - The value of the parameter

  Header values use OpenAPI's `simple` style. `:headers` is for scalars,
  `:headers_form` uses `explode=false`, and `:headers_form_exploded` uses
  `explode=true`. Arrays are comma-joined, and objects (including keyword
  lists) are flattened into key/value pairs. Cookie values use OpenAPI's `form`
  style: `:cookie` uses `explode=false` and `:cookie_exploded` uses `explode=true`.
  Values are kept unencoded; nested lists or maps raise `ArgumentError`.

  ### Returns

  Map
  """
  @spec add_param(map(), atom(), atom(), any()) :: map()
  def add_param(request, :body, :body, value), do: Map.put(request, :body, value)

  def add_param(request, :body, key, value) do
    request
    |> Map.put_new_lazy(:body, &Tesla.Multipart.new/0)
    |> Map.update!(:body, fn multipart ->
      Tesla.Multipart.add_field(
        multipart,
        key,
        JSON.encode!(value),
        headers: [{:"Content-Type", "application/json"}]
      )
    end)
  end

  def add_param(request, :headers, key, value) do
    headers =
      request
      |> Map.get(:headers, [])
      |> List.keystore(to_string(key), 0, {to_string(key), scalar_to_string(value)})

    Map.put(request, :headers, headers)
  end

  def add_param(request, :headers_form, key, value) do
    headers =
      request
      |> Map.get(:headers, [])
      |> List.keystore(to_string(key), 0, {to_string(key), serialize_parameter_value(value, ",")})

    Map.put(request, :headers, headers)
  end

  def add_param(request, :headers_form_exploded, key, value) do
    headers =
      request
      |> Map.get(:headers, [])
      |> List.keystore(to_string(key), 0, {to_string(key), serialize_parameter_value(value, "=")})

    Map.put(request, :headers, headers)
  end

  def add_param(request, :cookie, key, value) do
    add_cookies(request, [{to_string(key), serialize_parameter_value(value, ",")}])
  end

  def add_param(request, :cookie_exploded, key, value) do
    add_cookies(request, serialize_exploded_cookie(key, value))
  end

  def add_param(request, :file, name, path) do
    request
    |> Map.put_new_lazy(:body, &Tesla.Multipart.new/0)
    |> Map.update!(:body, &Tesla.Multipart.add_file(&1, path, name: to_string(name)))
  end

  def add_param(request, :multipart_form, name, value) do
    request
    |> Map.put_new_lazy(:body, &Tesla.Multipart.new/0)
    |> Map.update!(:body, &Tesla.Multipart.add_field(&1, to_string(name), to_string(value)))
  end

  def add_param(request, :form, name, value) do
    Map.update(request, :body, %{name => value}, &(Map.put(&1, name, value)))
  end

  def add_param(request, location, key, value) do
    Map.update(request, location, [{key, value}], &(&1 ++ [{key, value}]))
  end

  defp add_cookies(request, cookies) do
    Map.update(request, :cookie, cookies, fn existing_cookies ->
      existing_cookies ++ cookies
    end)
  end

  defp serialize_exploded_cookie(key, value) when is_list(value) do
    key = to_string(key)

    if parameter_pair_list?(value) do
      Enum.map(value, fn {pair_key, pair_value} ->
        {parameter_leaf_to_string(pair_key), parameter_leaf_to_string(pair_value)}
      end)
    else
      Enum.map(value, fn item ->
        {key, parameter_array_item_to_string(item)}
      end)
    end
  end

  defp serialize_exploded_cookie(key, value) when is_map(value) do
    cond do
      is_struct(value) and String.Chars.impl_for(value) != nil ->
        [{to_string(key), scalar_to_string(value)}]

      is_struct(value) ->
        value
        |> Map.from_struct()
        |> serialize_parameter_map_pairs()

      true ->
        serialize_parameter_map_pairs(value)
    end
  end

  defp serialize_exploded_cookie(key, value) do
    [{to_string(key), scalar_to_string(value)}]
  end

  defp serialize_parameter_map_pairs(value) do
    value
    |> parameter_map_entries()
    |> Enum.map(fn {key, value} ->
      {parameter_leaf_to_string(key), parameter_leaf_to_string(value)}
    end)
  end

  defp serialize_parameter_value(value, pair_separator) when is_list(value) do
    if parameter_pair_list?(value) do
      Enum.map_join(value, ",", fn {key, value} ->
        "#{parameter_leaf_to_string(key)}#{pair_separator}#{parameter_leaf_to_string(value)}"
      end)
    else
      Enum.map_join(value, ",", &parameter_array_item_to_string/1)
    end
  end

  defp serialize_parameter_value(value, pair_separator) when is_map(value) do
    cond do
      is_struct(value) and String.Chars.impl_for(value) != nil ->
        scalar_to_string(value)

      is_struct(value) ->
        value
        |> Map.from_struct()
        |> serialize_parameter_map(pair_separator)

      true ->
        serialize_parameter_map(value, pair_separator)
    end
  end

  defp serialize_parameter_value(value, _pair_separator), do: scalar_to_string(value)

  defp serialize_parameter_map(value, pair_separator) do
    value
    |> parameter_map_entries()
    |> Enum.map_join(",", fn {key, value} ->
      "#{parameter_leaf_to_string(key)}#{pair_separator}#{parameter_leaf_to_string(value)}"
    end)
  end

  defp parameter_map_entries(value) do
    value
    |> Map.to_list()
    |> Enum.sort_by(fn {key, _value} -> parameter_leaf_to_string(key) end)
  end

  defp parameter_pair_list?(value) do
    Enum.all?(value, fn pair -> is_tuple(pair) and tuple_size(pair) == 2 end)
  end

  defp parameter_array_item_to_string(%_{} = value) do
    if String.Chars.impl_for(value) != nil do
      scalar_to_string(value)
    else
      raise ArgumentError,
        "nested parameter values are not supported; expected scalar array items, got: #{inspect(value)}"
    end
  end

  defp parameter_array_item_to_string(value) when is_list(value) or is_map(value) do
    raise ArgumentError,
      "nested parameter values are not supported; expected scalar array items, got: #{inspect(value)}"
  end

  defp parameter_array_item_to_string(value), do: scalar_to_string(value)

  defp parameter_leaf_to_string(%_{} = value) do
    if String.Chars.impl_for(value) != nil do
      scalar_to_string(value)
    else
      raise ArgumentError,
        "nested parameter values are not supported; expected a scalar leaf, got: #{inspect(value)}"
    end
  end

  defp parameter_leaf_to_string(value) when is_list(value) or is_map(value) do
    raise ArgumentError,
      "nested parameter values are not supported; expected a scalar leaf, got: #{inspect(value)}"
  end

  defp parameter_leaf_to_string(value), do: scalar_to_string(value)

  defp scalar_to_string(value) do
    to_string(value)
  rescue
    Protocol.UndefinedError ->
      raise ArgumentError, "parameter values must contain scalar leaves, got: #{inspect(value)}"
  end

  @doc """
  This function ensures that the `body` parameter is always set.

  When using Tesla with the `httpc` adapter (the default adapter), there is a
  bug where POST, PATCH and PUT requests will fail if the body is empty.

  ### Parameters

  - `request` (Map) - Collected request options

  ### Returns

  Map
  """
  @spec ensure_body(map()) :: map()
  def ensure_body(%{body: nil} = request) do
    %{request | body: ""}
  end

  def ensure_body(request) do
    Map.put_new(request, :body, "")
  end

  @doc """
  Render cookie parameters as a single `cookie` header.

  Any caller-supplied `cookie` header is preserved and the generated cookies
  are appended to it.
  """
  @spec finalize_request(map()) :: map()
  def finalize_request(%{cookie: cookies} = request) when cookies != [] do
    cookie_header = Enum.map_join(cookies, "; ", fn {key, value} -> "#{key}=#{value}" end)

    headers =
      request
      |> Map.get(:headers, [])
      |> append_cookie_header(cookie_header)

    request
    |> Map.put(:headers, headers)
    |> Map.delete(:cookie)
  end

  def finalize_request(request), do: Map.delete(request, :cookie)

  defp append_cookie_header(headers, cookie_header) do
    case Enum.find_index(headers, fn {key, _} -> String.downcase(to_string(key)) == "cookie" end) do
      nil -> [{"cookie", cookie_header} | headers]
      index ->
        List.update_at(headers, index, fn {key, value} ->
          if String.trim(to_string(value)) == "" do
            {key, cookie_header}
          else
            {key, "#{value}; #{cookie_header}"}
          end
        end)
    end
  end

  @type status_code :: :default | 100..599
  @type response_mapping :: [{status_code, false | %{} | module()}]

  @doc """
  Evaluate the response from a Tesla request.
  Decode the response for a Tesla request.

  If no response mapping matches, a 2xx response is successful and any other
  response is returned as an error.

  ### Parameters

  - `result` (Tesla.Env.result()): The response from Tesla.request/2.
  - `mapping` ([{http_status, struct}]): The mapping for status to struct for decoding.

  ### Returns

  - `{:ok, struct}`, {:ok, [struct]} or `{:ok, Tesla.Env.t()}` on success
  - `{:error, term}` on failure
  """
  @spec evaluate_response(Tesla.Env.result(), response_mapping) ::
          {:ok, struct() | [struct()] | Tesla.Env.t()} | {:error, Tesla.Env.t() | any()}
  def evaluate_response({:ok, %Tesla.Env{} = env}, mapping) do
    resolve_mapping(env, mapping, nil)
  end

  def evaluate_response({:error, _} = error, _), do: error

  defp resolve_mapping(%Tesla.Env{status: status} = env, [{mapping_status, struct} | _], _)
      when status == mapping_status do
    decode(env, struct)
  end

  defp resolve_mapping(env, [{:default, struct} | tail], _), do: resolve_mapping(env, tail, struct)

  defp resolve_mapping(env, [_ | tail], struct), do: resolve_mapping(env, tail, struct)

  defp resolve_mapping(%Tesla.Env{status: status} = env, [], nil) when status in 200..299,
    do: {:ok, env}

  defp resolve_mapping(env, [], nil), do: {:error, env}

  defp resolve_mapping(env, [], struct), do: decode(env, struct)

  defp decode(%Tesla.Env{} = env, false), do: {:ok, env}

  defp decode(%Tesla.Env{body: body}, %{}) do
    {{moduleName}}.Deserializer.json_decode(body)
  end

  defp decode(%Tesla.Env{body: body}, module) do
    {{moduleName}}.Deserializer.json_decode(body, module)
  end
end
