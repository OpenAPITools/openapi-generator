using System;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using {{packageName}}.{{clientPackage}};

namespace {{packageName}}.Extensions
{
    /// <summary>
    /// Extension methods for IHostApplicationBuilder
    /// </summary>
    {{>visibility}} static class IHostApplicationBuilderExtensions
    {
        {{^hasAuthMethods}}
        /// <summary>
        /// Add the api to your application builder.
        /// </summary>
        /// <param name="builder"></param>
        public static IHostApplicationBuilder Configure{{apiName}}(this IHostApplicationBuilder builder)
        {
            HostConfiguration config = new(builder.Services);

            IServiceCollectionExtensions.Add{{apiName}}(builder.Services, config);

            return builder;
        }

        {{/hasAuthMethods}}
        /// <summary>
        /// Add the api to your application builder.
        /// </summary>
        /// <param name="builder"></param>
        /// <param name="options"></param>
        public static IHostApplicationBuilder Configure{{apiName}}(this IHostApplicationBuilder builder, Action<HostConfiguration>{{nrt?}} options = null)
        {
            HostConfiguration config = new(builder.Services);

            options?.Invoke(config);

            IServiceCollectionExtensions.Add{{apiName}}(builder.Services, config);

            return builder;
        }
    }
}
